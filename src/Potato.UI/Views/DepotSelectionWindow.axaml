<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Potato.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="Potato.UI.Views.DepotSelectionWindow"
        x:DataType="vm:DepotSelectionViewModel"
        Title="Select Depots to Download"
        Width="700" Height="500"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <!-- Header -->
        <Border Grid.Row="0" Background="#252528" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock Text="{Binding GameName}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="{Binding AppId, StringFormat='App ID: {0}'}" FontSize="12" Foreground="#888888"/>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#C06C84" IsVisible="{Binding IsLoading}"/>
            </StackPanel>
        </Border>

        <!-- Depots List -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Depots}" AutoGenerateColumns="False"
                  IsReadOnly="False" GridLinesVisibility="All"
                  BorderThickness="1" BorderBrush="#333336" CornerRadius="4">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected}" Width="70"/>
                <DataGridTextColumn Header="Depot ID" Binding="{Binding DepotId}" IsReadOnly="True" Width="90"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="OS" Binding="{Binding OsList}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="Lang" Binding="{Binding Language}" IsReadOnly="True" Width="70"/>
                <DataGridTextColumn Header="Manifest ID" Binding="{Binding ManifestId}" IsReadOnly="True" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom Controls -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button Content="Select All" Command="{Binding SelectAllCommand}"/>
                <Button Content="Deselect All" Command="{Binding DeselectAllCommand}"/>
                <Button Content="Windows Only" Command="{Binding SelectWindowsOnlyCommand}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Background="#3A3A3C"/>
                <Button Content="📥 Start Download" Command="{Binding ConfirmCommand}" Background="#C06C84" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
