<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Potato.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="Potato.UI.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Potato Settings"
        Width="550" Height="450"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="14">
            <TextBlock Text="⚙️ Preferences &amp; Paths" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>

            <!-- Custom Steam Path -->
            <StackPanel Spacing="4">
                <TextBlock Text="Custom Steam Directory (Optional):" FontSize="12" Foreground="#AAAAAA"/>
                <TextBox Text="{Binding CustomSteamPath}" PlaceholderText="Auto-detected if empty"/>
            </StackPanel>

            <!-- Custom SLSsteam Path -->
            <StackPanel Spacing="4">
                <TextBlock Text="Custom SLSsteam config.yaml (Optional):" FontSize="12" Foreground="#AAAAAA"/>
                <TextBox Text="{Binding CustomSlssteamConfigPath}" PlaceholderText="Auto-detected if empty"/>
            </StackPanel>

            <!-- Custom DepotDownloader Path -->
            <StackPanel Spacing="4">
                <TextBlock Text="Custom DepotDownloader Path (Optional):" FontSize="12" Foreground="#AAAAAA"/>
                <TextBox Text="{Binding CustomDepotDownloaderPath}" PlaceholderText="Auto-detected if empty"/>
            </StackPanel>

            <!-- Hubcap API Key -->
            <StackPanel Spacing="4">
                <TextBlock Text="Hubcap API Key:" FontSize="12" Foreground="#AAAAAA"/>
                <TextBox Text="{Binding HubcapApiKey}" PasswordChar="*" PlaceholderText="Optional for manifest history"/>
            </StackPanel>

            <!-- Toggles -->
            <CheckBox IsChecked="{Binding SlssteamModeEnabled}" Content="Enable SLSsteam Auto-Integration"/>
            <CheckBox IsChecked="{Binding AutoGenerateAcf}" Content="Auto-generate appmanifest_*.acf on download finish"/>
        </StackPanel>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Background="#3A3A3C"/>
            <Button Content="💾 Save Settings" Command="{Binding SaveCommand}" Background="#C06C84" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
