<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Potato.UI.ViewModels"
             xmlns:mat="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Potato.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <Style Selector="Button.tab-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.tab-btn:hover">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{Binding SelectedSubTab, StringFormat='Settings • {0}'}" FontSize="24" FontWeight="Bold" Foreground="#FAFAFA" />
                <TextBlock Text="Configure downloader, manifests, integrations, and SLSsteam behavior" FontSize="13" Foreground="#A1A1AA" />
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding SaveSettingsCommand}"
                    Background="#3B82F6"
                    Height="38"
                    CornerRadius="8"
                    Padding="18,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <mat:MaterialIcon Kind="ContentSave" Width="16" Height="16" Foreground="#FFFFFF" />
                    <TextBlock Text="Save Settings" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ── TAB CONTENTS ──────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <!-- Status Toast -->
                <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="12,8" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#93C5FD" />
                </Border>

                <!-- ── 1. POTATO SUB-TAB ─────────────────────────────────────── -->
                <StackPanel Spacing="14" IsVisible="{Binding SelectedSubTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Potato'}">
                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Hubcap API Configuration" FontSize="16" FontWeight="Bold" Foreground="#FAFAFA" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="Hubcap API Key:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBox Grid.Column="0" Text="{Binding HubcapApiKey}" PasswordChar="•" PlaceholderText="Enter your Morrenus / Hubcap API key..." Height="38" CornerRadius="8" Margin="0,0,10,0" />
                                    <Button Grid.Column="1" Command="{Binding TestApiKeyCommand}" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" Height="38" CornerRadius="8" Padding="14,0">
                                        <TextBlock Text="Test Key / Quotas" FontSize="12" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Separator Background="#27272A" Height="1" />

                            <CheckBox IsChecked="{Binding AutoFetchManifests}" Content="Auto-fetch manifests on game selection" />
                            <CheckBox IsChecked="{Binding SkipSingleChoice}" Content="Skip selection dialog if game has only 1 choice" />
                            <CheckBox IsChecked="{Binding CheckUpdatesOnStartup}" Content="Check for game updates automatically on startup" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── 2. DOWNLOADS SUB-TAB ──────────────────────────────────── -->
                <StackPanel Spacing="14" IsVisible="{Binding SelectedSubTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Downloads'}">
                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Download &amp; Depot Engine" FontSize="16" FontWeight="Bold" Foreground="#FAFAFA" />

                            <Grid ColumnDefinitions="*, *">
                                <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                                    <TextBlock Text="Max Concurrent Queue Jobs:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                    <NumericUpDown Value="{Binding MaxConcurrentQueueJobs}" Minimum="1" Maximum="8" Height="36" CornerRadius="6" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6" Margin="12,0,0,0">
                                    <TextBlock Text="DepotDownloader Max Connections:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                    <NumericUpDown Value="{Binding MaxDownloadsPerJob}" Minimum="1" Maximum="32" Height="36" CornerRadius="6" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Default SteamApps Download Directory:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                <TextBox Text="{Binding DefaultDownloadDirectory}" PlaceholderText="~/.local/share/Steam/steamapps (leave empty for automatic detection)" Height="38" CornerRadius="8" />
                            </StackPanel>

                            <Separator Background="#27272A" Height="1" />

                            <TextBlock Text="Depot Filters &amp; Cache:" FontSize="13" FontWeight="Bold" Foreground="#FAFAFA" />
                            <CheckBox IsChecked="{Binding UseLanCache}" Content="Use Local LAN Cache / HTTP Cache" />
                            <CheckBox IsChecked="{Binding ValidateDownloads}" Content="Validate SHA-1 File Chunks during download" />
                            <CheckBox IsChecked="{Binding FilterMacOsDepots}" Content="Automatically filter out macOS / Mac binaries" />
                            <CheckBox IsChecked="{Binding FilterSoundtracks}" Content="Automatically filter out Soundtracks and OSTs" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── 3. ADVANCED SUB-TAB ───────────────────────────────────── -->
                <StackPanel Spacing="14" IsVisible="{Binding SelectedSubTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Advanced'}">
                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Advanced Engine Options" FontSize="16" FontWeight="Bold" Foreground="#FAFAFA" />
                            <CheckBox IsChecked="{Binding LimitToSteamLibraries}" Content="Limit scans strictly to registered Steam library folders" />
                            <CheckBox IsChecked="{Binding NerdMode}" Content="Enable Verbose Debug Logging" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── 4. INTEGRATIONS SUB-TAB ───────────────────────────────── -->
                <StackPanel Spacing="14" IsVisible="{Binding SelectedSubTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Integrations'}">
                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Network &amp; Steam Integrations" FontSize="16" FontWeight="Bold" Foreground="#FAFAFA" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="Custom Steam Directory Override:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                <TextBox Text="{Binding CustomSteamPath}" PlaceholderText="~/.local/share/Steam (Leave empty for auto-detect)" Height="38" CornerRadius="8" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Custom Wirecutter / Mirror URL:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                <TextBox Text="{Binding CustomWirecutterUrl}" PlaceholderText="Optional mirror URL..." Height="38" CornerRadius="8" />
                            </StackPanel>

                            <CheckBox IsChecked="{Binding UseIspBypass}" Content="Use ISP Bypass Mirror for Hubcap API" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── 5. SLS SUB-TAB ────────────────────────────────────────── -->
                <StackPanel Spacing="14" IsVisible="{Binding SelectedSubTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='SLS'}">
                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="SLSsteam Integration (Linux App Unlocker)" FontSize="16" FontWeight="Bold" Foreground="#FAFAFA" />

                            <CheckBox IsChecked="{Binding EnableSlsIntegration}" Content="Enable SLSsteam Auto-Unlocking &amp; IPC Pipe Management" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="Custom SLSsteam config.yaml Path:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                <TextBox Text="{Binding CustomSlsConfigPath}" PlaceholderText="~/.local/share/Steam/slssteam/config.yaml" Height="38" CornerRadius="8" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*, Auto" Margin="0,6,0,0">
                                <TextBlock Grid.Column="0" Text="{Binding IpcDiagnosticsText}" FontSize="12" Foreground="#10B981" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding TestIpcCommand}" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" Height="36" CornerRadius="8" Padding="14,0">
                                    <TextBlock Text="Probe IPC Pipe" FontSize="12" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── 6. TOOLS SUB-TAB ──────────────────────────────────────── -->
                <StackPanel Spacing="14" IsVisible="{Binding SelectedSubTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Tools'}">
                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Maintenance &amp; Reset Tools" FontSize="16" FontWeight="Bold" Foreground="#FAFAFA" />

                            <Grid ColumnDefinitions="*, *">
                                <Button Grid.Column="0" Command="{Binding ClearManifestCacheCommand}" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" Height="40" CornerRadius="8" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <mat:MaterialIcon Kind="Broom" Width="16" Height="16" Foreground="#60A5FA" />
                                        <TextBlock Text="Clear Manifest Cache" FontSize="12" FontWeight="SemiBold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" Command="{Binding ImportFromAccelaCommand}" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" Height="40" CornerRadius="8" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <mat:MaterialIcon Kind="FileImport" Width="16" Height="16" Foreground="#34D399" />
                                        <TextBlock Text="Import ACCELA.conf" FontSize="12" FontWeight="SemiBold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Separator Background="#27272A" Height="1" />

                            <Button Command="{Binding ResetDefaultsCommand}" Background="#27181B" BorderBrush="#542127" BorderThickness="1" Height="40" CornerRadius="8" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <mat:MaterialIcon Kind="Restart" Width="16" Height="16" Foreground="#F87171" />
                                    <TextBlock Text="Reset All Settings to Defaults" FontSize="12" FontWeight="SemiBold" Foreground="#F87171" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
