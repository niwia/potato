<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Potato.UI.ViewModels"
             xmlns:mat="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Potato.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="8,4,8,24">
            <!-- Header Toolbar -->
            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" Padding="18,14" CornerRadius="12">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Settings &amp; Configuration" FontSize="20" FontWeight="Bold" Foreground="#FAFAFA" />
                        <TextBlock Text="Direct INI binding to ~/.config/Tachibana Labs/ACCELA.conf" FontSize="11" Foreground="#71717A" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button Command="{Binding ResetDefaultsCommand}"
                                Background="#27272A"
                                BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="36"
                                Padding="12,0">
                            <TextBlock Text="Defaults" FontSize="13" FontWeight="SemiBold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                        </Button>

                        <Button Command="{Binding SaveSettingsCommand}"
                                Background="#3B82F6"
                                CornerRadius="8"
                                Height="36"
                                Padding="16,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mat:MaterialIcon Kind="Check" Width="16" Height="16" Foreground="#FFFFFF" />
                                <TextBlock Text="Save Settings" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#10B981" FontWeight="SemiBold" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Hubcap API & Cloud Card -->
            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Hubcap API Authentication &amp; Proxy" FontSize="15" FontWeight="Bold" Foreground="#FAFAFA" />
                    <Separator Background="#27272A" Height="1" />

                    <Grid ColumnDefinitions="200, *">
                        <TextBlock Grid.Column="0" Text="Hubcap API Key:" VerticalAlignment="Center" Foreground="#A1A1AA" />
                        <TextBox Grid.Column="1" Text="{Binding HubcapApiKey}" PasswordChar="●" PlaceholderText="Enter your Morrenus Hubcap API key..." Height="36" CornerRadius="6" />
                    </Grid>

                    <Grid ColumnDefinitions="200, *">
                        <TextBlock Grid.Column="0" Text="ISP Bypass Mode:" VerticalAlignment="Center" Foreground="#A1A1AA" />
                        <CheckBox Grid.Column="1" IsChecked="{Binding UseIspBypass}" Content="Enable Cloudflare Worker ISP Bypass (Bypasses ISP blocks)" />
                    </Grid>

                    <Grid ColumnDefinitions="200, *">
                        <TextBlock Grid.Column="0" Text="Custom Wirecutter URL:" VerticalAlignment="Center" Foreground="#A1A1AA" />
                        <TextBox Grid.Column="1" Text="{Binding CustomWirecutterUrl}" PlaceholderText="Default Hubcap endpoint if left blank..." Height="36" CornerRadius="6" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Downloader & Concurrency Card -->
            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Downloader &amp; Queue Concurrency" FontSize="15" FontWeight="Bold" Foreground="#FAFAFA" />
                    <Separator Background="#27272A" Height="1" />

                    <Grid ColumnDefinitions="240, *, 60">
                        <TextBlock Grid.Column="0" Text="Chunk Threads per Job:" VerticalAlignment="Center" Foreground="#A1A1AA" />
                        <Slider Grid.Column="1" Minimum="1" Maximum="30" Value="{Binding MaxDownloadsPerJob}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="2" Text="{Binding MaxDownloadsPerJob}" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid ColumnDefinitions="240, *, 60">
                        <TextBlock Grid.Column="0" Text="Max Concurrent Downloads:" VerticalAlignment="Center" Foreground="#A1A1AA" />
                        <Slider Grid.Column="1" Minimum="1" Maximum="5" Value="{Binding MaxConcurrentQueueJobs}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="2" Text="{Binding MaxConcurrentQueueJobs}" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <CheckBox IsChecked="{Binding UseLanCache}" Content="Use LAN Cache" />
                        <CheckBox IsChecked="{Binding ValidateDownloads}" Content="Validate SHA-1 Chunks" />
                        <CheckBox IsChecked="{Binding LimitToSteamLibraries}" Content="Limit to Steam Libraries" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SLSsteam Integration Card -->
            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="SLSsteam &amp; Steam Integrations" FontSize="15" FontWeight="Bold" Foreground="#FAFAFA" />
                    <Separator Background="#27272A" Height="1" />

                    <CheckBox IsChecked="{Binding EnableSlsIntegration}" Content="Enable Automatic SLSsteam config.yaml Synchronization &amp; IPC Unlock" />

                    <Grid ColumnDefinitions="200, *">
                        <TextBlock Grid.Column="0" Text="Steam Path Override:" VerticalAlignment="Center" Foreground="#A1A1AA" />
                        <TextBox Grid.Column="1" Text="{Binding CustomSteamPath}" PlaceholderText="Auto-detected (~/.local/share/Steam or Flatpak) if blank..." Height="36" CornerRadius="6" />
                    </Grid>

                    <Grid ColumnDefinitions="200, *">
                        <TextBlock Grid.Column="0" Text="SLS Config Path:" VerticalAlignment="Center" Foreground="#A1A1AA" />
                        <TextBox Grid.Column="1" Text="{Binding CustomSlsConfigPath}" PlaceholderText="Auto-detected config.yaml if blank..." Height="36" CornerRadius="6" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
