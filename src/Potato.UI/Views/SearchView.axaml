<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Potato.UI.ViewModels"
             xmlns:mat="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Potato.UI.Views.SearchView"
             x:DataType="vm:SearchViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- Search Input Bar -->
        <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" Padding="16,14" Margin="0,0,0,14" CornerRadius="12">
            <Grid ColumnDefinitions="*, Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding SearchQuery}"
                         PlaceholderText="Search games by name or Steam AppID (e.g. Cyberpunk, Elden Ring, 603960, 813230)..."
                         Height="40"
                         CornerRadius="8"
                         Margin="0,0,12,0"
                         VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Command="{Binding FetchMetadataCommand}"
                        IsEnabled="{Binding !IsSearching}"
                        Background="#3B82F6"
                        Height="40"
                        CornerRadius="8"
                        Padding="16,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mat:MaterialIcon Kind="Magnify" Width="16" Height="16" Foreground="#FFFFFF" />
                        <TextBlock Text="Search / Fetch" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Search Results & Install Options -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSearching}" Height="4" Margin="0,0,0,4" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#A1A1AA" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- ── LIVE SEARCH RESULTS CARDS ──────────────────────────────── -->
                <Border Background="#18181B"
                        BorderBrush="#27272A"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        IsVisible="{Binding HasSearchResults}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="{Binding SearchResults.Count, StringFormat='Search Results ({0})'}" FontSize="15" FontWeight="Bold" Foreground="#FAFAFA" />
                            <TextBlock Grid.Column="1" Text="Click a game to select &amp; view depots" FontSize="12" Foreground="#71717A" VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:SearchResultItemViewModel">
                                    <Button Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).SelectSearchResultCommand}"
                                            CommandParameter="{Binding}"
                                            Background="#121215"
                                            BorderBrush="#27272A"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                                        <Grid ColumnDefinitions="100, *, Auto">
                                            <!-- Banner Thumbnail -->
                                            <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True" Background="#27272A" Width="100" Height="48" Margin="0,0,12,0">
                                                <Image asyncImageLoader:ImageLoader.Source="{Binding HeaderImageUrl}" Stretch="UniformToFill" />
                                            </Border>

                                            <!-- Game Title & Metadata -->
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding AppId, StringFormat='AppID: {0}'}" FontSize="11" Foreground="#60A5FA" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding FormattedSize, StringFormat='• Size: {0}'}" FontSize="11" Foreground="#A1A1AA" />
                                                    <Border Background="#065F46" CornerRadius="4" Padding="6,1" IsVisible="{Binding IsInLibrary}">
                                                        <TextBlock Text="In Library" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Select Arrow -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="Select" FontSize="12" FontWeight="SemiBold" Foreground="#60A5FA" VerticalAlignment="Center" />
                                                <mat:MaterialIcon Kind="ChevronRight" Width="16" Height="16" Foreground="#60A5FA" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── RESOLVED GAME CARD & DEPOT SELECTION ───────────────────── -->
                <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="20" IsVisible="{Binding HasResolvedGame}">
                    <StackPanel Spacing="16">
                        <!-- Header Details -->
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding Metadata.Name}" FontSize="22" FontWeight="Bold" Foreground="#FAFAFA" />
                                <TextBlock Text="{Binding Metadata.AppId, StringFormat='{}AppID: {0}'}" FontSize="13" Foreground="#60A5FA" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Metadata.InstallDir, StringFormat='{}Target Directory: steamapps/common/{0}'}" FontSize="12" Foreground="#71717A" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#27272A" CornerRadius="8" Padding="12,6" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Metadata.BuildId, StringFormat='{}Build {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#FAFAFA" />
                            </Border>
                        </Grid>

                        <Separator Background="#27272A" Height="1" />

                        <!-- Installation Options Row -->
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                                <TextBlock Text="Target Steam Library Drive:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                <ComboBox ItemsSource="{Binding AvailableLibraries}" SelectedItem="{Binding SelectedLibrary}" HorizontalAlignment="Stretch" Height="36" CornerRadius="6" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6" Margin="12,0,0,0">
                                <TextBlock Text="Branch:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" HorizontalAlignment="Stretch" Height="36" CornerRadius="6" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <CheckBox IsChecked="{Binding UnlockSls}" Content="Unlock in SLSsteam (Linux)" />
                            <CheckBox IsChecked="{Binding ValidateDownloads}" Content="Validate SHA-1 Chunks" />
                        </StackPanel>

                        <Separator Background="#27272A" Height="1" />

                        <!-- Depots Checklist -->
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <TextBlock Grid.Column="0" Text="Select Depots to Download:" FontSize="14" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="Smart OS" Command="{Binding ApplySmartSelectionCommand}" Background="#27272A" Height="30" Padding="10,0" CornerRadius="6" FontSize="12" />
                                <Button Content="All" Command="{Binding SelectAllDepotsCommand}" Background="#27272A" Height="30" Padding="10,0" CornerRadius="6" FontSize="12" />
                                <Button Content="None" Command="{Binding DeselectAllDepotsCommand}" Background="#27272A" Height="30" Padding="10,0" CornerRadius="6" FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="10" MaxHeight="240">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Depots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:DepotSelectionItemViewModel">
                                            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                                        <TextBlock Text="{Binding DepotId, StringFormat='{}Depot {0}'}" FontSize="11" Foreground="#71717A" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Size}" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Enqueue Button -->
                        <Button Command="{Binding EnqueueInstallCommand}"
                                Background="#3B82F6"
                                Foreground="#FFFFFF"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Height="42"
                                CornerRadius="8"
                                Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mat:MaterialIcon Kind="Download" Width="18" Height="18" Foreground="#FFFFFF" />
                                <TextBlock Text="Download Game &amp; Add to Queue" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
