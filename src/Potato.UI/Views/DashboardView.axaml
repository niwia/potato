<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Potato.UI.ViewModels"
             xmlns:mat="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Potato.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Margin="8,4,8,24">
            <!-- Header Bar -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold" Foreground="#FAFAFA" />
                    <TextBlock Text="Local Steam library overview, download analytics, and quick actions" FontSize="13" Foreground="#A1A1AA" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Command="{Binding GoToSearchCommand}"
                            Background="#27272A"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="36"
                            Padding="12,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mat:MaterialIcon Kind="Magnify" Width="16" Height="16" Foreground="#FAFAFA" />
                            <TextBlock Text="Search Game" FontSize="13" FontWeight="SemiBold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding GoToQueueCommand}"
                            Background="#3B82F6"
                            CornerRadius="8"
                            Height="36"
                            Padding="14,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mat:MaterialIcon Kind="Download" Width="16" Height="16" Foreground="#FFFFFF" />
                            <TextBlock Text="View Queue" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 4 Metrics Stats Cards -->
            <Grid ColumnDefinitions="*, *, *, *" Margin="0,4,0,0">
                <!-- Card 1: Total Games -->
                <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,8,0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Managed Games" FontSize="13" FontWeight="Medium" Foreground="#A1A1AA" />
                            <mat:MaterialIcon Grid.Column="1" Kind="Folder" Width="18" Height="18" Foreground="#71717A" />
                        </Grid>
                        <TextBlock Text="{Binding InstalledGamesCount, StringFormat='{}{0} Games'}" FontSize="24" FontWeight="Bold" Foreground="#FAFAFA" />
                        <TextBlock Text="{Binding FormattedTotalStorage, StringFormat='{}{0} on disk'}" FontSize="12" Foreground="#71717A" />
                    </StackPanel>
                </Border>

                <!-- Card 2: Active Downloads -->
                <Border Grid.Column="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="4,0,4,0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Active Pipeline" FontSize="13" FontWeight="Medium" Foreground="#A1A1AA" />
                            <mat:MaterialIcon Grid.Column="1" Kind="Download" Width="18" Height="18" Foreground="#3B82F6" />
                        </Grid>
                        <TextBlock Text="{Binding ActiveDownloadsCount, StringFormat='{}{0} Active'}" FontSize="24" FontWeight="Bold" Foreground="#FAFAFA" />
                        <TextBlock Text="{Binding DownloadSpeedText, StringFormat='Speed: {0}'}" FontSize="12" Foreground="#3B82F6" FontWeight="Medium" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Queued Jobs -->
                <Border Grid.Column="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="4,0,4,0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Queue Status" FontSize="13" FontWeight="Medium" Foreground="#A1A1AA" />
                            <mat:MaterialIcon Grid.Column="1" Kind="ClockOutline" Width="18" Height="18" Foreground="#F59E0B" />
                        </Grid>
                        <TextBlock Text="{Binding QueuedJobsCount, StringFormat='{}{0} Pending'}" FontSize="24" FontWeight="Bold" Foreground="#FAFAFA" />
                        <TextBlock Text="Jobs waiting in line" FontSize="12" Foreground="#71717A" />
                    </StackPanel>
                </Border>

                <!-- Card 4: SLSsteam Status -->
                <Border Grid.Column="3" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="8,0,0,0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="SLSsteam Unlock" FontSize="13" FontWeight="Medium" Foreground="#A1A1AA" />
                            <mat:MaterialIcon Grid.Column="1" Kind="Server" Width="18" Height="18" Foreground="#10B981" />
                        </Grid>
                        <TextBlock Text="{Binding SlsSteamStatus}" FontSize="15" FontWeight="Bold" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="IPC Pipe &amp; YAML Config" FontSize="12" Foreground="#71717A" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main Split Cards -->
            <Grid ColumnDefinitions="3*, 2*" Margin="0,6,0,0">
                <!-- Recent Games Overview Card -->
                <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                    <Grid RowDefinitions="Auto, *">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Recent Managed Games" FontSize="16" FontWeight="Bold" Foreground="#FAFAFA" />
                                <TextBlock Text="Quick access to games installed through Potato / ACCELA" FontSize="12" Foreground="#71717A" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding GoToLibraryCommand}"
                                    Background="Transparent"
                                    Foreground="#3B82F6"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Padding="8,4">
                                <TextBlock Text="View All Library →" />
                            </Button>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding RecentGames}"
                                 Background="Transparent"
                                 MaxHeight="360">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:InstalledGameViewModel">
                                    <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                            <mat:MaterialIcon Grid.Column="0" Kind="Folder" Width="18" Height="18" Foreground="#A1A1AA" Margin="0,0,12,0" VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding InstallDir}" FontSize="11" Foreground="#71717A" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="#27272A" CornerRadius="6" Padding="8,3" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedSize}" FontSize="11" FontWeight="Medium" Foreground="#D4D4D8" />
                                            </Border>

                                            <Border Grid.Column="3" Background="#1E293B" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AppId, StringFormat='AppID {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Quick Actions & Integrations Card -->
                <Border Grid.Column="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Quick Actions &amp; Tools" FontSize="16" FontWeight="Bold" Foreground="#FAFAFA" />
                            <TextBlock Text="Common management shortcuts" FontSize="12" Foreground="#71717A" />
                        </StackPanel>

                        <!-- Shortcut 1: Library Search -->
                        <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <mat:MaterialIcon Grid.Column="0" Kind="Magnify" Width="20" Height="20" Foreground="#3B82F6" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Search &amp; Download" FontSize="13" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                    <TextBlock Text="Find Steam games &amp; manifests" FontSize="11" Foreground="#71717A" />
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding GoToSearchCommand}" Content="Open" Background="#27272A" Foreground="#FAFAFA" Height="28" Padding="10,0" CornerRadius="6" FontSize="12" />
                            </Grid>
                        </Border>

                        <!-- Shortcut 2: SLSsteam Tools -->
                        <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <mat:MaterialIcon Grid.Column="0" Kind="Wrench" Width="20" Height="20" Foreground="#10B981" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="SLSsteam Tools" FontSize="13" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                    <TextBlock Text="Manage AdditionalApps &amp; IPC" FontSize="11" Foreground="#71717A" />
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding GoToSlsToolsCommand}" Content="Manage" Background="#27272A" Foreground="#FAFAFA" Height="28" Padding="10,0" CornerRadius="6" FontSize="12" />
                            </Grid>
                        </Border>

                        <!-- Shortcut 3: Download Queue -->
                        <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <mat:MaterialIcon Grid.Column="0" Kind="Download" Width="20" Height="20" Foreground="#F59E0B" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Active Queue" FontSize="13" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                    <TextBlock Text="View live download bandwidth" FontSize="11" Foreground="#71717A" />
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding GoToQueueCommand}" Content="View" Background="#27272A" Foreground="#FAFAFA" Height="28" Padding="10,0" CornerRadius="6" FontSize="12" />
                            </Grid>
                        </Border>

                        <!-- System Info Box -->
                        <Border Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="System Environment" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" />
                                <TextBlock Text="• Architecture: Linux x64 (.NET 10 / 9 Runtime)" FontSize="11" Foreground="#71717A" />
                                <TextBlock Text="• Active Config: ~/.config/Tachibana Labs/ACCELA.conf" FontSize="11" Foreground="#71717A" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="• Hubcap Manifest Tier 1 &amp; Tier 2: Enabled" FontSize="11" Foreground="#71717A" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
