<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Potato.UI.ViewModels"
             xmlns:mat="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
             x:Class="Potato.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid RowDefinitions="Auto, *" Margin="4,0,4,16">
        <!-- ── 1. ASSella VISOR STATUS BAR ─────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="#121215"
                BorderBrush="#27272A"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,10"
                Margin="0,0,0,14">
            <StackPanel Spacing="8">
                <!-- Top Ticker Bar -->
                <Border Background="#18181B"
                        BorderBrush="#27272A"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,4"
                        HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TopTickerText}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#93C5FD"
                               LetterSpacing="0.8"
                               HorizontalAlignment="Center" />
                </Border>

                <!-- Visor Status Grid Row 1 -->
                <Grid ColumnDefinitions="*, Auto, Auto" Margin="4,2,4,0">
                    <!-- Hubcap Quota String -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Hubcap:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                        <TextBlock Text="{Binding HubcapQuotaText}"
                                   ToolTip.Tip="{Binding HubcapQuotaTooltip}"
                                   FontSize="12"
                                   FontFamily="Monospace"
                                   FontWeight="Medium"
                                   Foreground="#FAFAFA"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- SLSsteam Status -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="SLSsteam:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                        <TextBlock Text="{Binding SlsStatusText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#10B981"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Steam Client Status -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Steam:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                        <TextBlock Text="{Binding SteamStatusText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#10B981"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Visor Status Grid Row 2 -->
                <Grid ColumnDefinitions="Auto, Auto, Auto, *" Margin="4,0,4,2">
                    <!-- Hubcap Connection Mode -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="Hubcap:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                        <TextBlock Text="{Binding HubcapConnectionText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#10B981"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Steam Updates Status -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="Steam Updates:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                        <TextBlock Text="{Binding SteamUpdatesText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#10B981"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- App Version -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="Potato:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                        <TextBlock Text="{Binding AppVersionText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#10B981"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Library Summary -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Library:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                        <TextBlock Text="{Binding LibrarySummaryText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#FAFAFA"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── 2. TWO-COLUMN WORKSPACE: PENDING UPDATES & RECENT ACTIVITY ──────── -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *" Margin="0">
            <!-- ── LEFT COLUMN: PENDING UPDATES ────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="#18181B"
                    BorderBrush="#27272A"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,8,0">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- Column Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <mat:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="#60A5FA" />
                            <TextBlock Text="PENDING UPDATES" FontSize="14" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                            <Border Background="#27272A" CornerRadius="10" Padding="8,2" IsVisible="{Binding PendingUpdatesCount}">
                                <TextBlock Text="{Binding PendingUpdatesCount}" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Updates List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <!-- Empty State -->
                            <Border Background="#121215"
                                    BorderBrush="#27272A"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="24"
                                    Margin="0,20,0,0"
                                    HorizontalAlignment="Stretch"
                                    IsVisible="{Binding !PendingUpdates.Count}">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <mat:MaterialIcon Kind="CheckCircleOutline" Width="36" Height="36" Foreground="#10B981" HorizontalAlignment="Center" />
                                    <TextBlock Text="All Games Up to Date" FontSize="14" FontWeight="Bold" Foreground="#FAFAFA" HorizontalAlignment="Center" />
                                    <TextBlock Text="No pending updates found. Click Check Updates below to scan." FontSize="12" Foreground="#71717A" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Pending Update Items -->
                            <ItemsControl ItemsSource="{Binding PendingUpdates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:PendingUpdateItemViewModel">
                                        <Border Background="#121215"
                                                BorderBrush="#27272A"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="64, *, Auto">
                                                <!-- Thumbnail Image -->
                                                <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True" Background="#27272A" Width="64" Height="36" Margin="0,0,12,0">
                                                    <Image asyncImageLoader:ImageLoader.Source="{Binding HeaderUrl}" Stretch="UniformToFill" />
                                                </Border>

                                                <!-- Game Info -->
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding BuildDiffSummary}" FontSize="11" Foreground="#60A5FA" />
                                                </StackPanel>

                                                <!-- Single Update Button -->
                                                <Button Grid.Column="2"
                                                        Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).UpdateSingleCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#27272A"
                                                        BorderBrush="#3F3F46"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Height="30"
                                                        Padding="10,0"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <mat:MaterialIcon Kind="Download" Width="14" Height="14" Foreground="#FAFAFA" />
                                                        <TextBlock Text="Update" FontSize="11" FontWeight="SemiBold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Action Controls -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto, *" Margin="0,12,0,0">
                        <!-- Check Updates Button -->
                        <Button Grid.Column="0"
                                Command="{Binding CheckUpdatesCommand}"
                                Background="#27272A"
                                BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="40"
                                Padding="14,0"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mat:MaterialIcon Kind="Refresh" Width="18" Height="18" Foreground="#60A5FA" />
                                <TextBlock Text="{Binding CheckStatusText}" FontSize="13" FontWeight="SemiBold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Update All (N) Button -->
                        <Button Grid.Column="1"
                                Command="{Binding UpdateAllCommand}"
                                IsEnabled="{Binding PendingUpdatesCount}"
                                Background="#3B82F6"
                                CornerRadius="8"
                                Height="40"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <mat:MaterialIcon Kind="DownloadMultiple" Width="18" Height="18" Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding PendingUpdatesCount, StringFormat='Update All ({0})'}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── RIGHT COLUMN: RECENT ACTIVITY ───────────────────────────────── -->
            <Border Grid.Column="1"
                    Background="#18181B"
                    BorderBrush="#27272A"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="8,0,0,0">
                <Grid RowDefinitions="Auto, *">
                    <!-- Column Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <mat:MaterialIcon Kind="History" Width="18" Height="18" Foreground="#A1A1AA" />
                            <TextBlock Text="RECENT ACTIVITY" FontSize="14" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Activity Log List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentActivities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ActivityLogItemViewModel">
                                    <Border Background="#121215"
                                            BorderBrush="#27272A"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,10"
                                            Margin="0,0,0,8">
                                        <StackPanel Spacing="3">
                                            <!-- Top Line: Game Name + Timestamp -->
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding GameName}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="#FAFAFA"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding FormattedTimestamp, StringFormat='[{0}]'}"
                                                           FontSize="11"
                                                           FontFamily="Monospace"
                                                           Foreground="#71717A" />
                                            </Grid>

                                            <!-- Middle Line: Status Summary -->
                                            <TextBlock Text="{Binding StatusSummary}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding StatusColor}" />

                                            <!-- Bottom Line: Sub Details -->
                                            <TextBlock Text="{Binding Details}"
                                                       FontSize="11"
                                                       Foreground="#71717A"
                                                       IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
