<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Potato.UI.ViewModels"
             xmlns:mat="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Potato.UI.Views.QueueView"
             x:DataType="vm:QueueViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- Toolbar Header -->
        <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" Padding="18,14" Margin="0,0,0,16" CornerRadius="12">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Download Queue" FontSize="20" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                    <Border Background="#27272A" CornerRadius="8" Padding="10,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AggregateSpeedFormatted, StringFormat='{}Speed: {0}'}" FontSize="12" Foreground="#10B981" FontWeight="Bold" />
                    </Border>
                    <Border Background="#27272A" CornerRadius="8" Padding="10,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RunningCount, StringFormat='{}{0} Active'}" FontSize="12" FontWeight="SemiBold" Foreground="#FAFAFA" />
                    </Border>
                    <Border Background="#27272A" CornerRadius="8" Padding="10,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding QueuedCount, StringFormat='{}{0} Queued'}" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Command="{Binding PauseAllCommand}"
                            Background="#27272A"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="36"
                            Padding="12,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mat:MaterialIcon Kind="Pause" Width="14" Height="14" Foreground="#FAFAFA" />
                            <TextBlock Text="Pause All" FontSize="13" FontWeight="SemiBold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ResumeAllCommand}"
                            Background="#27272A"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="36"
                            Padding="12,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mat:MaterialIcon Kind="Play" Width="14" Height="14" Foreground="#FAFAFA" />
                            <TextBlock Text="Resume All" FontSize="13" FontWeight="SemiBold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ClearCompletedCommand}"
                            Background="#27272A"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="36"
                            Padding="12,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mat:MaterialIcon Kind="Delete" Width="14" Height="14" Foreground="#A1A1AA" />
                            <TextBlock Text="Clear Finished" FontSize="13" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Queue Items List -->
        <Border Grid.Row="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Jobs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:QueueJobItemViewModel">
                            <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="10">
                                    <!-- Row 1: Header + Badges + Actions -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto">
                                        <Border Grid.Column="0" Background="#1E293B" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding AppId}" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="#27272A" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="#D4D4D8" />
                                        </Border>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="Pause" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}" Background="#27272A" Height="28" Padding="10,0" CornerRadius="6" FontSize="11" />
                                            <Button Content="Resume" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" Background="#3B82F6" Height="28" Padding="10,0" CornerRadius="6" FontSize="11" />
                                            <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" Background="#27181B" BorderBrush="#542127" BorderThickness="1" Foreground="#F87171" Height="28" Padding="10,0" CornerRadius="6" FontSize="11" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 2: Progress Bar -->
                                    <ProgressBar Grid.Row="1" Value="{Binding Percentage}" Maximum="100" Height="6" CornerRadius="3" Foreground="#3B82F6" Background="#27272A" />

                                    <!-- Row 3: Stats (Speed, ETA, Percentage, Current File) -->
                                    <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Percentage, StringFormat='{}{0:F1}%'}" FontSize="12" FontWeight="Bold" Foreground="#FAFAFA" />
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentFile, StringFormat='{} • {0}'}" FontSize="11" Foreground="#71717A" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding SpeedFormatted}" FontSize="11" Foreground="#10B981" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding EtaFormatted, StringFormat='{}ETA: {0}'}" FontSize="11" Foreground="#A1A1AA" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
