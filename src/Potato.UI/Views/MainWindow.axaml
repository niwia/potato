<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Potato.UI.ViewModels"
        xmlns:m="using:Potato.Core.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="Potato.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Potato"
        Width="980" Height="620"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F12">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="14,10">

        <!-- Top Navigation Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="{Binding VersionTag}" FontSize="10.5" Foreground="#666674" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Potato" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button Content="🔍" Command="{Binding SearchOrFetchCommand}" Background="Transparent" Foreground="#C8C8D4" FontSize="13" Padding="6,3" ToolTip.Tip="Quick Search &amp; Deploy"/>
                <Button Content="🗂️" Command="{Binding OpenLibraryCommand}" Background="Transparent" Foreground="#C8C8D4" FontSize="13" Padding="6,3" ToolTip.Tip="Game Library (Deployed Games)"/>
                <Button Content="⚙️" Command="{Binding OpenSettingsCommand}" Background="Transparent" Foreground="#C8C8D4" FontSize="13" Padding="6,3" ToolTip.Tip="Settings"/>
            </StackPanel>
        </Grid>

        <!-- Live Status Ticker Banner -->
        <Border Grid.Row="1" Background="#0A0A0D" BorderBrush="#1F1F28" BorderThickness="1" CornerRadius="6" Padding="12,5" HorizontalAlignment="Stretch" Margin="0,0,0,8">
            <TextBlock Text="{Binding StatusTickerText}" FontFamily="Monospace" FontSize="11" FontWeight="Bold" Foreground="#61AFEF" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- System Overview Dashboard Card -->
        <Border Grid.Row="2" Background="#16161C" BorderBrush="#262632" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,0,10">
            <StackPanel Spacing="3">
                <TextBlock Text="{Binding SystemStatsLine1}" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding SystemStatsLine2}" FontSize="11" Foreground="#98C379" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Two-Column Split Deck -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*">

            <!-- Left Column: Quick Deploy & Active Download -->
            <Border Grid.Column="0" Background="#16161C" BorderBrush="#262632" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0">
                    <!-- Column Header -->
                    <TextBlock Grid.Row="0" Text="QUICK DEPLOY &amp; DOWNLOAD" FontSize="11" FontWeight="ExtraBold" Foreground="#7E8294" Margin="0,0,0,8"/>

                    <!-- Search Input Box -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBox Grid.Column="0" Text="{Binding SearchQuery}" PlaceholderText="Enter Steam App ID or Game Title..." Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="Deploy" Command="{Binding SearchOrFetchCommand}" Background="#C06C84" Foreground="White" FontWeight="Bold" Padding="12,5"/>
                    </Grid>

                    <!-- Store Search Results List (When Search Yields Matches) -->
                    <Border Grid.Row="2" Background="#111115" BorderBrush="#262632" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,8"
                            IsVisible="{Binding SearchResults.Count}">
                        <ScrollViewer MaxHeight="130">
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectSearchResultCommand}" CommandParameter="{Binding}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Background="#1E1E26" Margin="0,2" Padding="8,4" CornerRadius="4">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding AppId, StringFormat='[{0}]'}" FontWeight="Bold" Foreground="#C06C84" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="📥 Select" Foreground="#98C379" FontSize="11"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Active Download Card / Status Panel -->
                    <Border Grid.Row="3" Background="#1B1B22" BorderBrush="#2F2F3D" BorderThickness="1" CornerRadius="6" Padding="12">
                        <Grid>
                            <!-- Active Download Layout (Visible when downloading) -->
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" IsVisible="{Binding HasActiveDownload}">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                                    <Image Grid.Column="0" Source="{Binding ActiveHeroImage}" Width="110" Height="52" Stretch="UniformToFill" Margin="0,0,10,0" IsVisible="{Binding ActiveHeroImage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding ActiveGameName}" FontSize="13.5" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ActiveSpeedText, StringFormat='Speed: {0}'}" FontSize="11" Foreground="#F8B195"/>
                                        <TextBlock Text="{Binding ActiveEtaText, StringFormat='ETA: {0}'}" FontSize="10.5" Foreground="#888892"/>
                                    </StackPanel>
                                </Grid>

                                <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding ActiveProgressPercent}" Height="12" CornerRadius="3" Margin="0,0,0,6" Foreground="#C06C84"/>

                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Text="{Binding ActiveStatusMessage}" FontSize="11" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="🛑 Cancel" Command="{Binding CancelDownloadCommand}" Background="#8B0000" Foreground="White" Padding="6,2" FontSize="10"/>
                                </Grid>
                            </Grid>

                            <!-- Idle State (Visible when no active download) -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsVisible="{Binding !HasActiveDownload}">
                                <TextBlock Text="🎮" FontSize="26" HorizontalAlignment="Center"/>
                                <TextBlock Text="All games up-to-date" FontSize="12.5" FontWeight="SemiBold" Foreground="#8A8D9F" HorizontalAlignment="Center"/>
                                <TextBlock Text="Ready for next deployment." FontSize="10.5" Foreground="#555562" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Column: Recent Activity & Live Logs -->
            <Border Grid.Column="1" Background="#16161C" BorderBrush="#262632" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                    <!-- Column Header -->
                    <TextBlock Grid.Row="0" Text="RECENT ACTIVITY" FontSize="11" FontWeight="ExtraBold" Foreground="#7E8294" Margin="0,0,0,8"/>

                    <!-- Recent Activities List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding RecentActivities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="m:RecentActivityItem">
                                    <Border Background="#1A1A22" BorderBrush="#282834" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                        <Grid RowDefinitions="Auto,Auto,Auto">
                                            <!-- Title & Time -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding GameName}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat='[{0}]'}" FontSize="10.5" Foreground="#777785"/>
                                            </Grid>
                                            <!-- Speed & Size metrics -->
                                            <TextBlock Grid.Row="1" Text="{Binding MetricsSummary}" FontSize="10.5" Foreground="#98C379" Margin="0,0,0,2"/>
                                            <!-- DRM / ACF details -->
                                            <TextBlock Grid.Row="2" Text="{Binding Details}" FontSize="10" Foreground="#888896"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Live Log Terminal Header -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="LIVE CONSOLE" FontSize="9.5" FontWeight="Bold" Foreground="#666675"/>
                        <Button Grid.Column="1" Content="Clear" Command="{Binding ClearLogsCommand}" Background="Transparent" Foreground="#666675" FontSize="9.5" Padding="4,1"/>
                    </Grid>

                    <!-- Live Log Output Box -->
                    <Border Grid.Row="3" Background="#0C0C0F" BorderBrush="#20202A" BorderThickness="1" CornerRadius="4" Padding="6" Height="80">
                        <ScrollViewer x:Name="LogScrollViewer">
                            <ItemsControl ItemsSource="{Binding LogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Monospace" FontSize="10" Foreground="#98C379" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

        </Grid>

        <!-- Bottom Quote / Easter Egg Bar -->
        <TextBlock Grid.Row="4" Text="{Binding EasterEggQuote}" FontStyle="Italic" FontSize="10.5" Foreground="#555564" HorizontalAlignment="Center" Margin="0,8,0,0"/>

    </Grid>
</Window>
