<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Potato.UI.ViewModels"
             xmlns:mat="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Potato.UI.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- Toolbar Header -->
        <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" Padding="18,14" Margin="0,0,0,16" CornerRadius="12">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Installed Library" FontSize="20" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                    <Border Background="#27272A" CornerRadius="8" Padding="10,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GamesCount, StringFormat='{}{0} Games'}" FontSize="12" FontWeight="SemiBold" Foreground="#FAFAFA" />
                    </Border>
                    <Border Background="#27272A" CornerRadius="8" Padding="10,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalSizeFormatted, StringFormat='{}Total: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Command="{Binding RefreshLibraryCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            Background="#27272A"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="36"
                            Padding="12,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mat:MaterialIcon Kind="Refresh" Width="16" Height="16" Foreground="#FAFAFA" />
                            <TextBlock Text="Rescan" FontSize="13" FontWeight="SemiBold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CheckUpdatesCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            Background="#3B82F6"
                            CornerRadius="8"
                            Height="36"
                            Padding="14,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mat:MaterialIcon Kind="Sparkles" Width="16" Height="16" Foreground="#FFFFFF" />
                            <TextBlock Text="Check Updates" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Games List -->
        <Border Grid.Row="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid RowDefinitions="Auto, *">
                <ProgressBar Grid.Row="0" IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="4" Margin="0,0,0,12" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:InstalledGameViewModel">
                                <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                        <!-- AppID Badge -->
                                        <Border Grid.Column="0" Background="#1E293B" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding AppId}" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" />
                                        </Border>

                                        <!-- Title & Path -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                            <TextBlock Text="{Binding FullGamePath}" FontSize="11" Foreground="#71717A" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Build & Size Info -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0" Spacing="2">
                                            <TextBlock Text="{Binding FormattedSize}" FontSize="13" FontWeight="SemiBold" Foreground="#FAFAFA" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding BuildId, StringFormat='{}Build {0}'}" FontSize="11" Foreground="#71717A" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding UpdateStatus}" FontSize="11" Foreground="#10B981" FontWeight="Medium" HorizontalAlignment="Right" />
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).UninstallGameCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="#27181B"
                                                    BorderBrush="#542127"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Height="32"
                                                    Padding="10,0">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <mat:MaterialIcon Kind="Delete" Width="14" Height="14" Foreground="#F87171" />
                                                    <TextBlock Text="Uninstall" FontSize="12" FontWeight="Medium" Foreground="#F87171" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
