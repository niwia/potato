<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Potato.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Potato.UI.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- Toolbar Header -->
        <Border Grid.Row="0" Background="#1E1F26" Padding="16,12" Margin="0,0,0,12" CornerRadius="8">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="🎮 Installed Library" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="#2C2D38" CornerRadius="12" Padding="8,2">
                        <TextBlock Text="{Binding GamesCount, StringFormat='{}{0} Games'}" FontSize="12" Foreground="#A0A0B0" />
                    </Border>
                    <Border Background="#2C2D38" CornerRadius="12" Padding="8,2">
                        <TextBlock Text="{Binding TotalSizeFormatted, StringFormat='{}Total: {0}'}" FontSize="12" Foreground="#A0A0B0" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="🔄 Rescan Library" Command="{Binding RefreshLibraryCommand}" IsEnabled="{Binding !IsLoading}" />
                    <Button Content="⚡ Check Updates" Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding !IsLoading}" Background="#3A3F58" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Games List -->
        <Border Grid.Row="1" Background="#181920" CornerRadius="8" Padding="12">
            <Grid RowDefinitions="Auto, *">
                <ProgressBar Grid.Row="0" IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="4" Margin="0,0,0,8" />

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:InstalledGameViewModel">
                                <Border Background="#22232D" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                        <!-- AppID Badge -->
                                        <Border Grid.Column="0" Background="#2C2D3B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding AppId}" FontSize="12" FontWeight="Bold" Foreground="#7C88FF" />
                                        </Border>

                                        <!-- Title & Path -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            <TextBlock Text="{Binding FullGamePath}" FontSize="11" Foreground="#75778A" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Build & Size Info -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0" Spacing="2">
                                            <TextBlock Text="{Binding FormattedSize}" FontSize="12" FontWeight="Medium" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding BuildId, StringFormat='{}Build {0}'}" FontSize="11" Foreground="#888899" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding UpdateStatus}" FontSize="11" Foreground="{Binding HasUpdate, Converter={x:Null}}" />
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="🗑 Uninstall" 
                                                    Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).UninstallGameCommand}" 
                                                    CommandParameter="{Binding}"
                                                    Background="#442228" Foreground="#FFAAAA" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
